@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

:root {
  --accent: #4a86ff;
  --accent-far: #b372de;
}

html {
  --canvas: #fff;
  --surface: #fff;
  --surface-muted: #fafafa;
  --surface-sunken: #f4f4f5;
  --border: #e4e4e7;
  --border-strong: #d4d4d8;
  --fg: #09090b;
  --fg-muted: #71717a;
  --fg-subtle: #a1a1aa;
  --bezel: inset 0 1px 0 #ffffff80, 0 1px 2px #09090b0d,
    0 14px 40px -12px #09090b1f;
  --lightningcss-light: initial;
  --lightningcss-dark: ;
  color-scheme: light;
}

html[data-theme="dark"] {
  --canvas: #09090b;
  --surface: #131316;
  --surface-muted: #1c1c21;
  --surface-sunken: #0f0f12;
  --border: #26262c;
  --border-strong: #3a3a43;
  --fg: #ededed;
  --fg-muted: #a1a1aa;
  --fg-subtle: #71717a;
  --bezel: inset 0 1px 0 #ffffff0f, 0 1px 2px #0006,
    0 16px 44px -12px #0009;
  --lightningcss-light: ;
  --lightningcss-dark: initial;
  color-scheme: dark;
}

html {
  background-color: var(--canvas);
  color: var(--fg);
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-sans);
  font-synthesis-weight: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  margin: 0;
}

* {
  scrollbar-width: thin;
  scrollbar-color: transparent transparent;
}

:hover, :focus-within {
  scrollbar-color: var(--border-strong) transparent;
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: none;
}

::-webkit-scrollbar-thumb {
  transition: background-color .15s var(--ease-out);
  background-color: #0000;
  background-clip: padding-box;
  border: 3px solid #0000;
  border-radius: 999px;
}

:hover::-webkit-scrollbar-thumb {
  background-color: var(--border-strong);
}

:focus-within::-webkit-scrollbar-thumb {
  background-color: var(--border-strong);
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--fg-subtle);
}

::-webkit-scrollbar-corner {
  background: none;
}

button:not(:disabled), [role="button"]:not(:disabled) {
  cursor: pointer;
}

::selection {
  background-color: var(--fg);
  color: var(--canvas);
}

.living {
  font-family: var(--font-serif);
  letter-spacing: -.035em;
  background-image: linear-gradient(180deg,
    var(--lit-1),
    var(--lit-2) 35%,
    var(--lit-3) 65%,
    var(--lit-4));
  color: #0000;
  -webkit-text-stroke: var(--lit-stroke);
  filter: var(--lit-bloom);
  -webkit-background-clip: text;
  background-clip: text;
  margin: -.18em -.08em;
  padding: .18em .08em;
  font-style: italic;
  font-weight: 400;
  display: inline-block;
  position: relative;
}

.living:after {
  content: attr(data-text);
  color: #0000;
  opacity: .45;
  background-image: linear-gradient(100deg, #0000 20%, #ffffffa6 48%, #0000 72%);
  background-position: 120% 0;
  background-size: 230% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: 3.2s ease-in-out infinite living-sweep;
  position: absolute;
  inset: .18em .08em;
}

@keyframes living-sweep {
  0%, 30% {
    background-position: 130% 0;
  }

  70%, 100% {
    background-position: -130% 0;
  }
}

html {
  --lit-1: #4a86ff;
  --lit-2: #2465ff;
  --lit-3: #1552ed;
  --lit-4: #1141b8;
  --lit-stroke: .35px #1552ed59;
  --lit-bloom: none;
}

html[data-theme="dark"] {
  --lit-1: #91bdff;
  --lit-2: #4a86ff;
  --lit-3: #2465ff;
  --lit-4: #1552ed;
  --lit-stroke: .35px #99c1ffa6;
  --lit-bloom: drop-shadow(0 0 1px #a4caffe6)
    drop-shadow(0 0 5px #2669ff61);
}

@media (prefers-reduced-motion: reduce) {
  .living:after {
    animation: none;
  }
}

:where(a, .press):focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 4px;
}

.display {
  letter-spacing: -.028em;
  text-wrap: balance;
  font-weight: 600;
}

.eyebrow {
  font-family: var(--font-mono);
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--fg-subtle);
  font-size: 11px;
  font-weight: 500;
}

.prose-site {
  color: var(--fg-muted);
  text-wrap: pretty;
  font-size: 15px;
  line-height: 1.65;
}

.prose-site strong {
  color: var(--fg);
  font-weight: 600;
}

.prose-site em {
  font-style: italic;
}

.prose-site a {
  color: var(--fg);
  text-decoration: underline;
  -webkit-text-decoration-color: var(--border-strong);
  text-decoration-color: var(--border-strong);
  text-underline-offset: 3px;
  transition: text-decoration-color .15s var(--ease-out);
}

.prose-site a:hover {
  -webkit-text-decoration-color: var(--fg);
  text-decoration-color: var(--fg);
}

.prose-site code, .tick {
  font-family: var(--font-mono);
  color: var(--fg);
  background: var(--surface-sunken);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: .08em .34em;
  font-size: .875em;
}

.bezel {
  background: var(--surface-muted);
  border: 1px solid var(--border);
  box-shadow: var(--bezel);
  border-radius: 28px;
  min-width: 0;
  padding: 6px;
  overflow: hidden;
}

.bezel-core {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 22px;
  overflow: hidden;
}

@media (max-width: 640px) {
  .bezel {
    border-radius: 20px;
    padding: 5px;
  }

  .bezel-core {
    border-radius: 15px;
  }
}

.rail {
  width: var(--rail);
  transition: width .22s var(--ease-out);
  display: none;
  overflow: hidden;
}

.when-narrow {
  display: grid;
}

.when-wide {
  display: none;
}

@media (min-width: 56rem) {
  .rail {
    display: flex;
  }

  .when-narrow {
    display: none;
  }

  .when-wide {
    display: grid;
  }
}

.docs-scroll {
  scroll-behavior: smooth;
}

@media (min-width: 56rem) {
  .with-rail {
    padding-left: max(var(--rail), 20px);
    transition: padding-left .22s var(--ease-out);
  }
}

@media (prefers-reduced-motion: reduce) {
  .rail, .with-rail {
    transition: none;
  }
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-soft);
  border-radius: 20px;
}

.press {
  transition: background-color .15s var(--ease-out),
    border-color .15s var(--ease-out),
    color .15s var(--ease-out),
    transform .12s var(--ease-out);
}

.press:active {
  transform: scale(.98);
}

.shiki, .shiki span {
  color: var(--shiki-light);
}

html[data-theme="dark"] .shiki, html[data-theme="dark"] .shiki span {
  color: var(--shiki-dark);
}

.shiki {
  font-size: 12.5px;
  line-height: 1.7;
  background: none !important;
}

@media (prefers-reduced-motion: reduce) {
  *, :before, :after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }

  .press:active {
    transform: none;
  }
}

